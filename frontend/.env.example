# Adresa backend-ului SideQuest, fără "/" la final.
#
# Local: copiază fișierul ca .env ca să chemi backend-ul direct (backend-ul permite implicit
# originea http://localhost:5173). Fără .env, `npm run dev` merge prin proxy-ul Vite (/api -> :8080).
#
# Vercel: setează VITE_API_URL în Project Settings -> Environment Variables, ex.
#   VITE_API_URL=https://sidequest-api.onrender.com
# Valoarea e inclusă în bundle la build, deci după o schimbare e nevoie de redeploy.
VITE_API_URL=http://localhost:8080
